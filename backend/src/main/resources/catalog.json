{
  "slug": "sla",
  "name": "知华服务等级管理",
  "subtitle": "服务协议、工单时限、升级处置与履约分析",
  "accent": "#51677e",
  "modules": [
    {
      "key": "agreements",
      "label": "服务协议",
      "description": "优先级、响应时限和解决时限",
      "initial": "ACTIVE",
      "editable": true,
      "creatable": true,
      "fields": [
        {
          "key": "name",
          "label": "协议名称",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "priority",
          "label": "优先级",
          "type": "select",
          "required": true,
          "ref": null,
          "options": [
            "P1",
            "P2",
            "P3"
          ],
          "min": null,
          "max": null
        },
        {
          "key": "responseHours",
          "label": "响应小时",
          "type": "integer",
          "required": true,
          "ref": null,
          "options": [],
          "min": "1",
          "max": "720"
        },
        {
          "key": "resolutionHours",
          "label": "解决小时",
          "type": "integer",
          "required": true,
          "ref": null,
          "options": [],
          "min": "1",
          "max": "2160"
        }
      ],
      "actions": []
    },
    {
      "key": "tickets",
      "label": "服务工单",
      "description": "响应、升级、解决、重开和履约记录",
