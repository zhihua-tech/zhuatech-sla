      "actions": [
        {
          "key": "acknowledge",
          "label": "确认响应",
          "from": [
            "OPEN"
          ],
          "to": "ACKNOWLEDGED",
          "role": "OPERATOR",
          "separate": false,
          "fields": []
        },
        {
          "key": "escalate",
          "label": "手动升级",
          "from": [
            "ACKNOWLEDGED"
          ],
          "to": "ESCALATED",
          "role": "ADMIN",
          "separate": true,
          "fields": [
            {
              "key": "reason",
              "label": "升级原因",
              "type": "text",
              "required": true,
              "ref": null,
              "options": [],
              "min": null,
              "max": null
            }
          ]
        },
        {
          "key": "resolve",
          "label": "解决问题",
          "from": [
            "ACKNOWLEDGED",
            "ESCALATED"
          ],
          "to": "RESOLVED",
          "role": "OPERATOR",
          "separate": false,
          "fields": []
        },
        {
          "key": "reopen",
          "label": "重新打开",
          "from": [
            "RESOLVED"
          ],
          "to": "OPEN",
          "role": "OPERATOR",
          "separate": false,
          "fields": []
        },
        {
          "key": "close",
          "label": "确认关闭",
          "from": [
            "RESOLVED"
          ],
          "to": "CLOSED",
          "role": "REVIEWER",
          "separate": true,
          "fields": []
        }
      ]
    },
    {
      "key": "breaches",
