      "editable": true,
      "creatable": true,
      "fields": [
        {
          "key": "agreement",
          "label": "服务协议",
          "type": "ref",
          "required": true,
          "ref": "agreements",
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "customer",
          "label": "客户名称",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "subject",
          "label": "问题摘要",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "openedAt",
          "label": "受理时间（UTC ISO-8601）",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        }
