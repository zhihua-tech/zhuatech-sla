      "initial": "OPEN",
      "editable": false,
      "creatable": false,
      "fields": [
        {
          "key": "ticket",
          "label": "工单",
          "type": "ref",
          "required": true,
          "ref": "tickets",
          "options": [],
          "min": null,
          "max": null
        },
        {
          "key": "reason",
          "label": "原因",
          "type": "text",
          "required": true,
          "ref": null,
          "options": [],
          "min": null,
          "max": null
        }
      ],
      "actions": [
        {
          "key": "acknowledge",
          "label": "分派升级负责人",
          "from": ["OPEN"],
          "to": "ACKNOWLEDGED",
          "role": "ADMIN",
          "separate": false,
          "fields": [
            {"key":"assignee","label":"负责人账号","type":"text","required":true,"ref":null,"options":[],"min":null,"max":null},
            {"key":"response","label":"处置要求","type":"text","required":true,"ref":null,"options":[],"min":null,"max":null}
          ]
        },
        {
          "key": "close",
          "label": "复核升级处置",
          "from": ["ACKNOWLEDGED"],
          "to": "CLOSED",
          "role": "REVIEWER",
          "separate": true,
          "fields": [
            {"key":"resolution","label":"处置结果","type":"text","required":true,"ref":null,"options":[],"min":null,"max":null}
          ]
        }
